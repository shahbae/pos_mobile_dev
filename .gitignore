# Obfuscation related
app.*.map.json

# Gradle menaruh laporan build di sini sejak AGP 8; bukan sumber.
/android/build/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android local config & signing (JANGAN pernah di-commit)
android/local.properties
android/key.properties
**/*.jks
**/*.keystore
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Build output / distribusi
# APK & bundle hasil build tidak masuk repo; unggah ke release/drive.
*.apk
*.aab
*.ipa
*.app.zip
/dist/

# Secrets
# CATATAN: .env sengaja TETAP di-commit karena dipakai sebagai Flutter asset
# (pubspec.yaml -> assets: - .env) dan dimuat flutter_dotenv saat startup.
# Isinya hanya API_BASE_URL. Jika nanti ada kredensial (mis. server key
# Midtrans), pindahkan ke --dart-define atau file terpisah lalu ignore.
*.pem
*.p12
*.mobileprovision
secrets.json

